# Documentation only. Run scripts/init_dev.py for generated local secrets.
PORTAL_ENV=development
DEBUG=true
SECRET_KEY=change-me-generate-at-least-50-random-characters
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=
PUBLIC_BASE_URL=http://127.0.0.1:8000
POSTGRES_DB=ubsi
POSTGRES_USER=ubsi
POSTGRES_PASSWORD=change-me-generate-a-random-password
DATABASE_URL=postgresql://ubsi:change-me@127.0.0.1:55432/ubsi
# Native development only; Compose overrides this with its private named volume.
PRIVATE_STORAGE_ROOT=/absolute/private/path/outside/the/repository
TRUST_HTTPS_PROXY=false
TRUSTED_PROXY_CIDRS=
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=
# Fixed windows shared by all workers; source means the TCP peer (REMOTE_ADDR).
LOGIN_SOURCE_LIMIT=30
LOGIN_ACCOUNT_LIMIT=5
RECOVERY_SOURCE_LIMIT=20
RECOVERY_ACCOUNT_LIMIT=3
TOKEN_SOURCE_LIMIT=60

# Optional document bounds; defaults are the approved initial contract.
DOCUMENT_SOURCE_BYTES=20971520
DOCUMENT_MAX_SHEETS=50
DOCUMENT_MAX_CELLS=200000
DOCUMENT_MAX_ROWS=20000
DOCUMENT_MAX_COLUMNS=200
DOCUMENT_EXPANDED_BYTES=209715200
DOCUMENT_MAX_PAGES=50
DOCUMENT_MAX_PIXELS=16000000
DOCUMENT_MAX_SIDE=8000
DRAWIO_PAGE_BYTES=8388608
PLANTUML_SECONDS=20
PLANTUML_HEAP_MB=256
DOCUMENT_JOB_SECONDS=60
DOCUMENT_CHILD_MEMORY_MB=1536
DOCUMENT_JAVA_ADDRESS_SPACE_MB=4096
# M6: offline CPU artifacts; default portal/.models (built into the container).
# SEARCH_CPU_THREADS=2
# SEARCH_MAX_CHUNKS=10000
# SEARCH_JOB_SECONDS=300
# CHATBOT_QUALIFICATION_FILE=/var/lib/ubsi/private/qualification/m6-approved.json
# Production Compose only: operator file outside the repository, immutable image.
# PORTAL_ENV_FILE=/private/operator/ubsi.env
# PORTAL_IMAGE=registry.example.invalid/ubsi/portal@sha256:<release-digest>
